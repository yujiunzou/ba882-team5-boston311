# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit it.
#
#   cp .env.example .env

# GCP project ID
GCP_PROJECT=ba882-team5-project

# GCS bucket where raw artifacts are landed
GCS_BUCKET=ba882-team5-boston311-raw

# BigQuery dataset and location
BQ_DATASET=boston311
BQ_LOCATION=us-central1

# Service account key for GCP auth.
# Put your key at include/gcp/sa-key.json in this repo (that folder is gitignored).
# This is the path inside the Airflow containers, so leave it as is.
GOOGLE_APPLICATION_CREDENTIALS=/usr/local/airflow/include/gcp/sa-key.json
